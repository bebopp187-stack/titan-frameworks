# HTTP port (Railway/Vercel override PORT automatically)
PORT=3333

# Set to true to mock-gate /mcp behind an x402 402 Payment Required response
X402_ENABLED=false

# Wallet that receives $0.001 USDC on Base when x402 is enabled
X402_PAY_TO=0x584c004037bc369b3b49bd18381a5a6d0c1c1215
# Set true to verify/settle Base USDC via PayAI (or X402_USDC_FACILITATOR_URL)
X402_USDC_LIVE=true
X402_USDC_FACILITATOR_URL=https://facilitator.payai.network

# XRPL / RLUSD x402 (alongside Base USDC)
XRPL_PAY_TO_ADDRESS=rkpckEddjHhS2vvg7sR3Gb3BX3CVzE2kb
XRPL_PRICE_DROPS=1000
XRPL_PRICE_RLUSD=0.001
# Mainnet: xrpl:0 + https://xrpl-facilitator-mainnet.t54.ai
# Testnet: xrpl:1 + https://xrpl-facilitator-testnet.t54.ai
XRPL_FACILITATOR_URL=https://xrpl-facilitator-mainnet.t54.ai
XRPL_NETWORK=xrpl:0
XRPL_SOURCE_TAG=804681468
# XRPL_RLUSD_ISSUER=rMxCKbEDwqr76QuheSUMdEGf4B9xJ8m5De
# Set true to POST PAYMENT-SIGNATURE to the XRPL facilitator before serving /mcp
X402_XRPL_LIVE=true

# Private admin dashboard password (required for /admin)
ADMIN_SECRET_KEY=change-me

# Optional GitHub token — higher rate limits while running `npm run index-docs`
# GITHUB_TOKEN=ghp_...
