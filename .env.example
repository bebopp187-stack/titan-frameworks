# HTTP port (Railway/Vercel override PORT automatically)
PORT=3333

# Set to true to mock-gate /mcp behind an x402 402 Payment Required response
X402_ENABLED=false

# Wallet that receives $0.001 USDC on Base when x402 is enabled
X402_PAY_TO=0x0000000000000000000000000000000000000000

# Optional GitHub token — higher rate limits while running `npm run index-docs`
# GITHUB_TOKEN=ghp_...
