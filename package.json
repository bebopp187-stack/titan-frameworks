{
  "name": "titan-frameworks",
  "version": "1.0.0",
  "description": "Titan Frameworks — MCP server that indexes LangChain, LlamaIndex, Ollama, and XRPL docs.",
  "type": "module",
  "main": "dist/http.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "start": "node dist/http.js",
    "start:stdio": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "index-docs": "tsx scripts/index-docs.ts",
    "test": "tsx scripts/smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "mcp",
    "langchain",
    "llamaindex",
    "ollama",
    "xrpl",
    "x402"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cheerio": "^1.1.2",
    "express": "^5.1.0",
    "x402-xrpl": "^0.3.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
